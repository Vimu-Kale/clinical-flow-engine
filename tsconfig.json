{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@clinical-flow/expression": ["packages/expression/src/index.ts"],
      "@clinical-flow/fhir-lite": ["packages/fhir-lite/src/index.ts"],
      "@clinical-flow/workflow-core": ["packages/workflow-core/src/index.ts"],
      "@clinical-flow/workflow-engine": ["packages/workflow-engine/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/studio/src/**/*.ts",
    "apps/studio/src/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "apps/studio/vite.config.ts"
  ]
}
